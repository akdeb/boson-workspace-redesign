# Server-only Boson API key. Mints short-lived browser credentials for Higgs Realtime, and
# calls Higgs TTS 3 (speech + voice cloning) and Higgs Avatar server-side.
BOSON_API_KEY=bai-your-key-here

# Optional API base URL override.
# BOSON_BASE_URL=https://api.boson.ai

# Which renderer Avatar Studio drives:
#   boson — the hosted Higgs Avatar API (POST /v1/videos). No GPU to manage. Default.
#   modal — the self-hosted LiveAvatar service below, which needs an explicit warm-up.
# AVATAR_PROVIDER=boson

# LiveAvatar renderer deployed on Modal — only needed for AVATAR_PROVIDER=modal.
# See ../boson-server/README.md; `modal deploy modal_app.py` prints the URL, and the token
# is the live-avatar-auth secret.
# LIVE_AVATAR_URL=https://your-workspace--live-avatar-api.modal.run
# LIVE_AVATAR_TOKEN=la_your-token-here

# Which self-hosted tier to drive: "single" (1 x H100) or "realtime" (5 x H100).
# LIVE_AVATAR_TIER=realtime

# Where the studio's SQLite file lives. Agents, tools, uploaded faces, cloned-voice labels
# and history are rows in it — see lib/db/schema.sql, and schema.postgres.sql for the
# Supabase twin. Defaults to .data/studio.db, which is gitignored.
# STUDIO_DB_PATH=.data/studio.db

# Optional. Powers the "Create" flow in Agent Studio, which drafts an agent's prompt, voice
# and tools from a short chat — see lib/agent-builder.ts. Boson has no text-completion model,
# so this is the one call that goes elsewhere. Without it, Create still opens a blank agent.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
